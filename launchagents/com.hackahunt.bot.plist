<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hackahunt.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/CHEMIN/VERS/hackahunt/venv/bin/python</string>
        <string>-u</string>
        <string>/CHEMIN/VERS/hackahunt/bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/CHEMIN/VERS/hackahunt</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/Users/VOTRE_USER/Library/Logs/hackahunt-bot.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/VOTRE_USER/Library/Logs/hackahunt-bot.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
