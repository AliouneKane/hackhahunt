<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hackahunt.scraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/CHEMIN/VERS/hackahunt/venv/bin/python</string>
        <string>-u</string>
        <string>/CHEMIN/VERS/hackahunt/scraper_cron.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/CHEMIN/VERS/hackahunt</string>

    <!-- Scraping toutes les 30 minutes (1800 secondes) -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/VOTRE_USER/Library/Logs/hackahunt-scraper.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/VOTRE_USER/Library/Logs/hackahunt-scraper.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
